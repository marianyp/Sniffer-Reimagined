{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "${mod_page_url}",
		"sources": "${mod_git_url}"
	},
	"license": "${mod_license}",
	"icon": "assets/snifferreimagined/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.mariany.snifferreimagined.SnifferReimagined"
		],
		"fabric-datagen": [
			"dev.mariany.snifferreimagined.SnifferReimaginedDataGenerator"
		]
	},
	"mixins": [
		"snifferreimagined.mixins.json"
	],
	"accessWidener": "snifferreimagined.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": ">=1.21.6",
		"java": ">=21",
		"fabric-api": ">=0.128.2"
	}
}